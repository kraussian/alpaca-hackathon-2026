# Paper accounts only. Never live keys, in this or any tracked file.
#
# Two accounts, per HANDOFF.md boundary 6:
#   dev         - a throwaway paper account. All probing, smoke tests and
#                 supervised-session practice happen here.
#   competition - the brand-new account funded to exactly $100,000, judged
#                 on its activity. Not traded before 28 Aug 2026 15:00 UTC.
#
# The broker refuses to construct if ALPACA_ACCOUNT_ROLE is unset, and refuses
# the competition role before kickoff. Unset is not a safe default, so there
# is no default.
ALPACA_ACCOUNT_ROLE=dev

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Claude API key for the agent loop.
ANTHROPIC_API_KEY=
